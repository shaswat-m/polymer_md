pair_coeff         * * 1.0 1.0 2.5
pair_coeff         2 3 15.0 1.0 2.5

pair_coeff         2 2 0.7 2.6 2.9184
pair_coeff         3 3 0.7 2.1 2.3572

bond_coeff        * 30.0 1.5 1.0 1.0
pair_modify        shift yes

timestep        0.001
reset_timestep 0
fix   1 all langevin 1.0 1.0 0.20 542305
fix   2 all press/berendsen iso 0.0 0.0 0.10
fix   3 all nve

thermo     100000
thermo_style custom step temp pe etotal epair pxx pyy pzz lx ly lz
compute p all pressure thermo_temp
run 10000
